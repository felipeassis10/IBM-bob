{
  "name": "geo-explorer",
  "version": "1.0.0",
  "description": "An MCP server that exposes learning tracks, challenges, and certificates for developers.",
  "main": "dist/mcp/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/mcp/server.js",
    "dev": "ts-node src/mcp/server.ts",
    "cli": "ts-node src/cli.ts",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
